local function destroyDungeonEvents()
	-- shrines / vents / props estilo Quantum AutoDungeonShrine
	local dungeon = (Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Dungeon"))
		or Workspace:FindFirstChild("Dungeon")
	if not dungeon then return false end

	local keywords = { "Shrine", "Vent", "Prop", "Event", "Totem", "Pillar", "Crystal", "Altar" }
	local targets = {}
	for _, d in ipairs(dungeon:GetDescendants()) do
		if d:IsA("BasePart") or d:IsA("Model") then
			local n = string.lower(d.Name)
			for _, k in ipairs(keywords) do
				if n:find(string.lower(k)) then
					local pos = d:IsA("BasePart") and d.Position or (d.PrimaryPart and d.PrimaryPart.Position)
					if not pos then
						local ok, piv = pcall(function() return d:GetPivot().Position end)
						if ok then pos = piv end
					end
					if pos then table.insert(targets, { Inst = d, Pos = pos }) end
					break
				end
			end
		end
	end
	if #targets == 0 then return false end
	table.sort(targets, function(a, b)
		return (a.Pos - humanoidRootPart.Position).Magnitude < (b.Pos - humanoidRootPart.Position).Magnitude
	end)
	local t = targets[1]
	topos(CFrame.new(t.Pos + Vector3.new(0, 5, 0)), true)
	if (humanoidRootPart.Position - t.Pos).Magnitude <= 40 then
		for _ = 1, 4 do
			customShoot(t.Pos)
			task.wait(0.06)
		end
		-- attack normal também
		equipWeapon(G.Weapon)
		local tool = character and character:FindFirstChildOfClass("Tool")
		if tool then pcall(function() tool:Activate() end) end
		return true
	end
	return false
end

local function selectDungeonCards()
	if not G.AutoCards then return end
	pcall(function()
		local gui = Player:FindFirstChild("PlayerGui")
		if not gui then return end
		-- tenta UI de cards
		for _, d in ipairs(gui:GetDescendants()) do
			if d:IsA("TextButton") or d:IsA("ImageButton") then
				local txt = string.lower(d.Text or d.Name or "")
				for card, on in pairs(G.SelectedCards) do
					if on and txt:find(string.lower(card)) then
						pcall(function()
							firesignal(d.MouseButton1Click)
							d:Activate()
						end)
					end
				end
			end
		end
		-- remote comum
		if Net then
			for card, on in pairs(G.SelectedCards) do
				if on then
					pcall(function()
						local rf = Net:FindFirstChild("RF/DungeonNPCNetworkFunction")
							or Net:FindFirstChild("RF/DungeonCard")
						if rf then rf:InvokeServer("SelectCard", card) end
					end)
				end
			end
		end
	end)
end

local function dungeonStep()
	if not humanoidRootPart then refreshChar() return end
	if humanoidRootPart.Position.Y < -30 then
		humanoidRootPart.CFrame = CFrame.new(humanoidRootPart.Position.X, 50, humanoidRootPart.Position.Z)
		ensureBV()
		return
	end
	selectDungeonCards()
	if G.AutoDungeonEvent then
		if destroyDungeonEvents() then return end
	end
	local mob = getDungeonMobs()
	if mob then
		doAttack(mob, true) -- sem bring
		return
	end
end

