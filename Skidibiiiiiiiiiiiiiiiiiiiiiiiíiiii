-- ========== TWEEN ==========
local tweenToken, tweening, bodyVelocity = 0, false, nil

local function ensureBV()
	if not humanoidRootPart then return end
	if bodyVelocity and bodyVelocity.Parent then return end
	local old = humanoidRootPart:FindFirstChild("PartVelocuty")
	if old then old:Destroy() end
	bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.Name = "PartVelocuty"
	bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	bodyVelocity.Velocity = Vector3.zero
	bodyVelocity.P = 1000
	bodyVelocity.Parent = humanoidRootPart
end

local function stopTween()
	tweenToken += 1
	tweening = false
	if bodyVelocity then pcall(function() if bodyVelocity.Parent then bodyVelocity:Destroy() end end) bodyVelocity = nil end
	if humanoidRootPart then
		local pv = humanoidRootPart:FindFirstChild("PartVelocuty")
		if pv then pv:Destroy() end
	end
end

local function topos(goalCF, keepBV)
	if tweening then return end
	if not humanoidRootPart or not humanoid or humanoid.Health <= 0 then return end
	local goal = typeof(goalCF) == "CFrame" and goalCF or CFrame.new(goalCF)
	if goal.Y < -50 then goal = CFrame.new(goal.X, 20, goal.Z) end
	local start = humanoidRootPart.CFrame
	local magnitude = (goal.Position - start.Position).Magnitude
	if magnitude <= 5 then
		humanoidRootPart.CFrame = goal
		if keepBV then ensureBV() end
		return
	end
	tweenToken += 1
	local my = tweenToken
	tweening = true
	ensureBV()
	if character then
		for _, p in pairs(character:GetDescendants()) do
			if p:IsA("BasePart") then p.CanCollide = false end
		end
	end
	task.spawn(function()
		local now, traveled = tick(), 0
		local speed = math.max(tonumber(G.TweenSpeed) or 250, 0.1)
		while my == tweenToken and humanoid and humanoid.Health > 0 and humanoidRootPart and humanoidRootPart.Parent do
			local now2 = tick()
			traveled += speed * (now2 - now)
			local a = math.clamp(traveled / magnitude, 0, 1)
			local cf = start:Lerp(goal, a)
			if cf.Y < -20 then cf = CFrame.new(cf.X, 20, cf.Z) end
			humanoidRootPart.CFrame = cf
			if bodyVelocity and bodyVelocity.Parent then bodyVelocity.Velocity = Vector3.zero end
			if a >= 1 or (goal.Position - humanoidRootPart.Position).Magnitude <= 10 then
				humanoidRootPart.CFrame = goal
				break
			end
			task.wait()
			now = now2
		end
		tweening = false
		if keepBV then ensureBV() else
			if bodyVelocity then pcall(function() bodyVelocity:Destroy() end) bodyVelocity = nil end
		end
	end)
end

local function getFarmCFrame(root)
	if not root or not root.Parent then return nil end
	local y = math.clamp(tonumber(G.PosY) or 20, 5, 30)
	if root.Position.Y < -50 then return nil end
	return CFrame.new(root.Position + Vector3.new(0, y, 0.5))
end

-- ========== COMBAT ==========
local function equipWeapon(kind)
	kind = kind or G.Weapon or "Melee"
	if not character or not humanoid then return end
	local function ok(t)
		local tip = tostring(t.ToolTip or "")
		if kind == "Fruit" or kind == "Blox Fruit" then return tip == "Blox Fruit"
		elseif kind == "Gun" then return tip == "Gun"
		elseif kind == "Sword" then return tip == "Sword"
		else return tip == "Melee" or tip == "Combat" end
	end
	for _, t in ipairs(character:GetChildren()) do if t:IsA("Tool") and ok(t) then return t end end
	for _, t in ipairs(Player.Backpack:GetChildren()) do
		if t:IsA("Tool") and ok(t) then humanoid:EquipTool(t) return t end
	end
end

local function autoHaki()
	pcall(function()
		if not character then return end
		if not character:HasTag("Buso") then FireInvoke("BuyHaki", "Buso") end
		if character:HasTag("Buso") and not character:FindFirstChild("HasBuso") then FireInvoke("Buso") end
	end)
end

local function doAttack(mob, noBring)
	if not mob or not mob.Parent then return end
	local root = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
	local hum = mob:FindFirstChildOfClass("Humanoid")
	if not root or not hum or hum.Health <= 0 or root.Position.Y < -50 then return end

	equipWeapon(G.Weapon)
	autoHaki()

	local farmCF = getFarmCFrame(root)
	if not farmCF then return end
	if humanoidRootPart and (humanoidRootPart.Position - farmCF.Position).Magnitude > 8 then
		topos(farmCF, true)
	elseif humanoidRootPart and farmCF.Y > -20 then
		ensureBV()
		humanoidRootPart.CFrame = farmCF
	end

	if not noBring and G.Bring then
		-- bring is called outside
	end

	local tool = character and character:FindFirstChildOfClass("Tool")
	if tool then
		local mp = tool:FindFirstChild("MousePos")
		if mp and mp:IsA("Vector3Value") then mp.Value = root.Position end
		pcall(function() tool:Activate() end)
	end
	if Net then
		local RA = Net:FindFirstChild("RE/RegisterAttack")
		local RH = Net:FindFirstChild("RE/RegisterHit")
		if RA and RH then
			pcall(function()
				RA:FireServer(0)
				RH:FireServer(mob:FindFirstChild("Head") or root, {{mob, root}})
			end)
		end
	end
end

-- ========== BRING ==========
local bringCache, lastBring, lastSim = {}, 0, 0

local function bringEnemies(target)
	if not G.Bring or not target or not humanoidRootPart then return end
	local tRoot = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
	if not tRoot or tRoot.Position.Y < -50 then return end
	local now = tick()
	if now - lastBring < 0.25 then return end
	lastBring = now
	local radius = tonumber(G.BringRange) or 350
	if now - lastSim > 3 then
		lastSim = now
		pcall(function()
			sethiddenproperty(Player, "SimulationRadius", math.clamp(radius + 50, 100, 500))
			sethiddenproperty(Player, "MaxSimulationRadius", math.clamp(radius + 50, 100, 500))
		end)
	end
	bringCache[target.Name] = tRoot.CFrame
	local tagged = CollectionService:GetTagged(BRING_TAG)
	for _, m in ipairs(tagged) do
		local h = m:FindFirstChildOfClass("Humanoid")
		if not m.Parent or not h or h.Health <= 0 then
			pcall(function() CollectionService:RemoveTag(m, BRING_TAG) end)
		end
	end
	if #tagged >= 8 then return end
	local en = Workspace:FindFirstChild("Enemies")
	if not en then return end
	local n = 0
	for _, e in ipairs(en:GetChildren()) do
		if e ~= target and e.Name == target.Name and not CollectionService:HasTag(e, BRING_TAG) then
			local r, h = e:FindFirstChild("HumanoidRootPart"), e:FindFirstChildOfClass("Humanoid")
			if r and h and h.Health > 0 and r.Position.Y > -50 then
				if (r.Position - tRoot.Position).Magnitude <= radius
					and (r.Position - humanoidRootPart.Position).Magnitude <= radius then
					CollectionService:AddTag(e, BRING_TAG)
					n += 1
					if n >= 4 then break end
				end
			end
		end
	end
end

CollectionService:GetInstanceAddedSignal(BRING_TAG):Connect(function(mob)
	task.spawn(function()
		local r = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
		local h = mob:FindFirstChildOfClass("Humanoid")
		if not r or not h then pcall(function() CollectionService:RemoveTag(mob, BRING_TAG) end) return end
		local bp = r:FindFirstChild("BringBodyPos") or Instance.new("BodyPosition")
		bp.Name = "BringBodyPos"
		bp.MaxForce = Vector3.new(1e6, 1e6, 1e6)
		bp.P = 8000
		bp.D = 600
		bp.Parent = r
		local expire, fails = tick() + 25, 0
		while G.Bring and mob.Parent and r.Parent and h.Health > 0
			and CollectionService:HasTag(mob, BRING_TAG) and tick() < expire do
			local cache, my = bringCache[mob.Name], humanoidRootPart
			if my and cache and cache.Y > -20 and (my.Position - r.Position).Magnitude <= (G.BringRange or 350) + 50 then
				for _, p in ipairs(mob:GetChildren()) do if p:IsA("BasePart") then p.CanCollide = false end end
				r.AssemblyLinearVelocity = Vector3.zero
				bp.Position = cache.Position
				fails = 0
			else fails += 1 end
			if fails > 15 then break end
			task.wait(0.04)
		end
		pcall(function()
			if bp and bp.Parent then bp:Destroy() end
			if CollectionService:HasTag(mob, BRING_TAG) then CollectionService:RemoveTag(mob, BRING_TAG) end
		end)
	end)
end)

-- ========== HELPERS ==========
local function getEnemy(mapOrName)
	local en = Workspace:FindFirstChild("Enemies")
	if not en or not humanoidRootPart then return nil end
	local best, bd = nil, math.huge
	for _, e in ipairs(en:GetChildren()) do
		local h, r = e:FindFirstChildOfClass("Humanoid"), e:FindFirstChild("HumanoidRootPart")
		if h and h.Health > 0 and r and r.Position.Y > -50 then
			local ok = type(mapOrName) == "string" and e.Name == mapOrName
				or type(mapOrName) == "table" and mapOrName[e.Name] == true
			if ok then
				local d = (r.Position - humanoidRootPart.Position).Magnitude
				if d < bd then bd, best = d, e end
			end
		end
	end
	return best
end

local function getNearestEnemy()
	local en = Workspace:FindFirstChild("Enemies")
	if not en or not humanoidRootPart then return nil end
	local best, bd = nil, math.huge
	for _, e in ipairs(en:GetChildren()) do
		local h, r = e:FindFirstChildOfClass("Humanoid"), e:FindFirstChild("HumanoidRootPart")
		if h and h.Health > 0 and r and r.Position.Y > -50 then
			local d = (r.Position - humanoidRootPart.Position).Magnitude
			if d < bd and d < 4000 then bd, best = d, e end
		end
	end
	return best
end

local function hasQuest(text)
	local q = Player:FindFirstChild("PlayerGui") and Player.PlayerGui:FindFirstChild("Main") and Player.PlayerGui.Main:FindFirstChild("Quest")
	if not (q and q.Visible) then return false end
	local title = q:FindFirstChild("Container") and q.Container:FindFirstChild("QuestTitle")
	title = title and title:FindFirstChild("Title")
	if title and title.Text then
		return string.find(string.lower(title.Text), string.lower(text)) ~= nil
	end
	return false
end

local function hasAnyQuest()
	local q = Player:FindFirstChild("PlayerGui") and Player.PlayerGui:FindFirstChild("Main") and Player.PlayerGui.Main:FindFirstChild("Quest")
	return q and q.Visible == true
end

-- quest: pega e NÃO fica parado — no próximo tick já farm
local questCooldown = 0
local function tryQuest(name, num, cf, keyword)
	if hasQuest(keyword) or hasAnyQuest() then return false end
	if tick() - questCooldown < 2 then return false end
	if humanoidRootPart and (humanoidRootPart.Position - cf.Position).Magnitude <= 30 then
		FireInvoke("StartQuest", name, num)
		questCooldown = tick()
		task.wait(0.35)
		return false -- já tem quest, próximo loop farm
	else
		topos(cf, false)
		return true -- ainda indo no NPC
	end
end

-- ========== SKULL GUITAR (Quantum CustomShoot) ==========
local function equipSkullGuitar()
	if not character or not humanoid then return nil end
	local t = character:FindFirstChild("Skull Guitar")
	if t then return t end
	t = Player.Backpack:FindFirstChild("Skull Guitar")
	if t then
		humanoid:EquipTool(t)
		task.wait(0.12)
		return character:FindFirstChild("Skull Guitar")
	end
	FireInvoke("LoadItem", "Skull Guitar")
	task.wait(0.35)
	t = Player.Backpack:FindFirstChild("Skull Guitar")
	if t then
		humanoid:EquipTool(t)
		task.wait(0.12)
	end
	return character and character:FindFirstChild("Skull Guitar")
end

local function customShoot(pos)
	local tool = equipSkullGuitar()
	if not tool then
		-- tenta qualquer gun
		equipWeapon("Gun")
		tool = character and character:FindFirstChildOfClass("Tool")
	end
	if not tool then return end

	pcall(function()
		tool.Enabled = true
		tool:SetAttribute("IsReloading_Client", false)
		tool:SetAttribute("LocalShotsLeft", 100)
		tool:SetAttribute("LocalTotalShots", (tool:GetAttribute("LocalTotalShots") or 0) + 1)
	end)

	-- Quantum handler Skull Guitar
	if tool:FindFirstChild("RemoteEvent") then
		pcall(function() tool.RemoteEvent:FireServer("TAP", pos) end)
		pcall(function() tool.RemoteEvent:FireServer("TAP", typeof(pos) == "Vector3" and pos or pos) end)
	end
	if Net then
		local S = Net:FindFirstChild("RE/ShootGunEvent")
		if S then
			pcall(function() S:FireServer(pos, { humanoidRootPart }) end)
		end
	end
	-- Activate fallback
	pcall(function() tool:Activate() end)
end

local function tyrantEyes()
	local map = Workspace:FindFirstChild("Map")
	local im = map and map:FindFirstChild("TikiOutpost") and map.TikiOutpost:FindFirstChild("IslandModel")
	if not im then return 0 end
	local e = im:FindFirstChild("IslandChunks") and im.IslandChunks:FindFirstChild("E")
	local eyes = { im:FindFirstChild("Eye1"), im:FindFirstChild("Eye2"), e and e:FindFirstChild("Eye3"), e and e:FindFirstChild("Eye4") }
	local n = 0
	for _, eye in ipairs(eyes) do if eye and eye.Transparency == 0 then n += 1 end end
	return n
end

local function attackTree()
	local map = Workspace:FindFirstChild("Map")
	local arena = map and map:FindFirstChild("TikiOutpost") and map.TikiOutpost:FindFirstChild("IslandModel")
		and map.TikiOutpost.IslandModel:FindFirstChild("IslandChunks")
		and map.TikiOutpost.IslandModel.IslandChunks:FindFirstChild("D")
		and map.TikiOutpost.IslandModel.IslandChunks.D:FindFirstChild("EagleBossArena")
	if not arena then return false end

	for _, child in ipairs(arena:GetChildren()) do
		if child.Name == "Tree" and child:IsA("Model") and child:FindFirstChild("Group") then
			local part = child.Group:GetChildren()[1]
			if part then
				local pos = part.Position or part.CFrame.Position
				local stick = CFrame.new(pos + Vector3.new(0, 2.5, 0))
				if humanoidRootPart and (humanoidRootPart.Position - pos).Magnitude > 8 then
					topos(stick, true)
				elseif humanoidRootPart then
					ensureBV()
					humanoidRootPart.CFrame = stick
				end
				if humanoidRootPart and (humanoidRootPart.Position - pos).Magnitude <= 25 then
					-- vários tiros Quantum style
					for _ = 1, 5 do
						customShoot(pos)
						task.wait(0.08)
					end
					return true
				end
			end
		end
	end
	return false
end

-- ========== FARMS ==========
local cakeCheck, cakeStr = 0, ""

local function farmTyrant()
	local boss = getEnemy("Tyrant of the Skies")
	if boss then doAttack(boss) bringEnemies(boss) return end
	if G.DestroyVases and tyrantEyes() >= 4 then attackTree() return end
	local mob = getEnemy(TyrantList)
	if mob then doAttack(mob) bringEnemies(mob) return end
	topos(CF.Tyrant, false)
end

local function farmBone()
	if G.AutoQuest then
		if tryQuest("HauntedQuest2", 1, CF.BoneQuest, "Demonic") then return end
	end
	local mob = getEnemy(BonesList)
	if mob then doAttack(mob) bringEnemies(mob) return end
	topos(CF.BoneFarm, false)
end

local function farmKatakuri()
	local prince = getEnemy("Cake Prince")
	if prince then
		if Player:GetAttribute("CurrentLocation") ~= "Dimensional Shift" then
			topos(CF.CakePortal, false)
			return
		end
		doAttack(prince) bringEnemies(prince) return
	end
	local now = tick()
	if now - cakeCheck > 4 then
		cakeCheck = now
		local res = FireInvoke("CakePrinceSpawner")
		if type(res) == "string" then cakeStr = res end
	end
	if type(cakeStr) == "string" and string.find(cakeStr, "open the portal now") then
		FireInvoke("CakePrinceSpawner")
		task.wait(0.6)
		return
	end
	if G.AutoQuest then
		if tryQuest("CakeQuest1", 1, CF.CakeQuest, "Cookie") then return end
	end
	local mob = getEnemy(CakesList)
	if mob then doAttack(mob) bringEnemies(mob) return end
	topos(CF.CakeFarm, false)
end

local function farmLevel()
	-- nearest mob (level farm simples, sem quest específica)
	local mob = getNearestEnemy()
	if mob then doAttack(mob) bringEnemies(mob) return end
end

local function farmStep()
	if not humanoidRootPart then refreshChar() return end
	if humanoidRootPart.Position.Y < -30 then
		humanoidRootPart.CFrame = CFrame.new(humanoidRootPart.Position.X, 50, humanoidRootPart.Position.Z)
		ensureBV()
		return
	end
	if G.FarmMode == "Bone" then farmBone()
	elseif G.FarmMode == "Katakuri" then farmKatakuri()
	elseif G.FarmMode == "Level" then farmLevel()
	else farmTyrant() end
end

